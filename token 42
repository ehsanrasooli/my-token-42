pragma solidity ^0.8.20;

contract OnChainMessageBoard {
    struct Message {
        address author;
        string text;
        uint256 timestamp;
    }

    Message[] public messages;

    event NewMessage(address indexed author, string text, uint256 timestamp);

    function postMessage(string memory _text) external {
        require(bytes(_text).length > 0, "Message cannot be empty");
        messages.push(Message({
            author: msg.sender,
            text: _text,
            timestamp: block.timestamp
        }));
        emit NewMessage(msg.sender, _text, block.timestamp);
    }

    function getTotalMessages() external view returns (uint256) {
        return messages.length;
    }
}
